NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of the MineNetr FastAPI backend (used by login/auth today;
# DGMS portal HTTP adapters later). Must be reachable from the browser —
# never assume localhost works from another device.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# DGMS portal data mode. "mock" (default) uses the centralized synthetic
# repository in lib/dgms (visible DEMO badge). "http" selects the typed
# HTTP adapters — only set this after confirming every endpoint in
# lib/dgms/api.ts with the backend. HTTP mode never falls back to mock data.
NEXT_PUBLIC_DGMS_DATA_MODE=mock

# Operations (Coal Mine Operations) portal data mode. "mock" (default) uses the
# centralized synthetic repository in lib/ops (visible DEMO badge). "http"
# selects the typed HTTP adapters in lib/ops/api.ts — only set this after
# confirming every endpoint with the backend. HTTP mode never falls back to
# mock data after a failure.
NEXT_PUBLIC_OPS_DATA_MODE=mock
