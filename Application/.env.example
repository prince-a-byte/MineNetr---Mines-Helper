# Demo / mock mode. Switch to "http" only after pointing EXPO_PUBLIC_API_BASE_URL
# at a reachable MineNetr FastAPI instance. HTTP mode never falls back to mock data.
EXPO_PUBLIC_DATA_MODE=mock

# Base URL of the future MineNetr FastAPI backend (no trailing slash).
# Android emulator -> http://10.0.2.2:8000
# iOS simulator   -> http://127.0.0.1:8000
# Physical device -> http://<dev-machine-LAN-ip>:8000  (never plain "localhost")
# Production      -> https://api.minenetr.example
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
